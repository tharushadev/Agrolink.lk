    {
      "name": "Diagnostics",
      "item": [
        {
          "name": "Mongo Connection + Users Count",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/diagnostics/mongo", "host": ["{{baseUrl}}"], "path": ["diagnostics", "mongo"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (Investor 1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-generate unique values on each signup run",
                  "const suffix = (Date.now() % 100000000).toString().padStart(8, '0');",
                  "pm.collectionVariables.set('investor1Phone', `07${suffix}`);",
                  "pm.collectionVariables.set('investor1Nic', `2000${suffix}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"INVESTOR\",\n  \"phoneNumber\": \"{{investor1Phone}}\",\n  \"password\": \"investorpass\",\n  \"nic\": \"{{investor1Nic}}\",\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Silva\"\n}"
            }
          }
        },
        {
          "name": "Signup (Investor 2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-generate unique values on each signup run",
                  "const suffix = ((Date.now() + 1234) % 100000000).toString().padStart(8, '0');",
                  "pm.collectionVariables.set('investor2Phone', `07${suffix}`);",
                  "pm.collectionVariables.set('investor2Nic', `2001${suffix}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
