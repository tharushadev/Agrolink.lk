{
  "info": {
    "name": "AgroLink API (Local)",
    "description": "AgroLink backend API collection for local testing. Auth is phone-only. If you have multiple backend processes running, point baseUrl to the active one (currently http://localhost:8083/api).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083/api" },
    { "key": "investor1Phone", "value": "0715550001" },
    { "key": "investor1Nic", "value": "200012345678" },
    { "key": "investor2Phone", "value": "0715550002" },
    { "key": "investor2Nic", "value": "200112345679" },
    { "key": "farmer1Phone", "value": "0771234568" },
    { "key": "farmer1Nic", "value": "199912345670" },
    { "key": "farmer2Phone", "value": "0771234569" },
    { "key": "farmer2Nic", "value": "199812345671" },
    { "key": "farmerId", "value": "FARMER_ID_HERE" },
    { "key": "investorId", "value": "INVESTOR_ID_HERE" },
    { "key": "projectId", "value": "PROJECT_ID_HERE" },
